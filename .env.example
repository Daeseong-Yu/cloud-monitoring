# 실제 값은 .env 또는 운영 환경 변수에만 둔다.
# 이 파일에는 credential, password, 실제 instance id, account id를 기록하지 않는다.

AWS_REGION=REPLACE_WITH_AWS_REGION
COLLECTOR_INTERVAL_SECONDS=60
CLOUDWATCH_LOOKBACK_MINUTES=15
GRAFANA_REFRESH_MINUTES=10
METRIC_RETENTION_DAYS=30

# 예시 placeholder이다. 실제 DATABASE_URL은 commit하지 않는다.
DATABASE_URL=postgres://cloud_monitor:change-me@127.0.0.1:5432/cloud_monitor?sslmode=disable
