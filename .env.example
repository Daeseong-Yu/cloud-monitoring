# 실제 값은 .env 또는 운영 환경 변수에만 둔다.
# 이 파일에는 credential, 실제 instance id, account id를 기록하지 않는다.

AWS_REGION=us-east-1
TARGET_INSTANCE_ID=REPLACE_WITH_INSTANCE_ID
CWAGENT_METRIC_NAME=mem_used_percent
COLLECTOR_INTERVAL_SECONDS=60
CLOUDWATCH_LOOKBACK_MINUTES=15
GRAFANA_REFRESH_MINUTES=10
METRIC_RETENTION_DAYS=30

# Docker Compose PostgreSQL placeholder이다. 운영 password는 .env에서만 바꾼다.
POSTGRES_DB=cloud_monitor
POSTGRES_USER=cloud_monitor
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://cloud_monitor:change-me@postgres:5432/cloud_monitor?sslmode=disable

# Grafana PostgreSQL datasource provisioning placeholder이다.
GRAFANA_POSTGRES_HOST=postgres
GRAFANA_POSTGRES_PORT=5432
GRAFANA_POSTGRES_USER=cloud_monitor
GRAFANA_POSTGRES_PASSWORD=change-me
GRAFANA_POSTGRES_DATABASE=cloud_monitor
GRAFANA_POSTGRES_SSLMODE=disable
GRAFANA_PORT=3000
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ANONYMOUS_ENABLED=false

# Admin UI는 Step 9에서 구현된다. 값은 Compose runtime 경계를 미리 고정하기 위한 placeholder이다.
ADMIN_HTTP_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Alert Runner는 Step 12에서 구현된다. 실제 webhook URL은 commit하지 않는다.
SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK_URL
