# Cloud Monitor reverse proxy example.
# Replace placeholders only on the target server. Do not commit real domains,
# certificate paths, public URLs, credentials, AWS account ids, ARNs, or resource ids.

server {
    listen 443 ssl http2;
    server_name REPLACE_WITH_GRAFANA_DOMAIN;

    ssl_certificate REPLACE_WITH_GRAFANA_CERT_PATH;
    ssl_certificate_key REPLACE_WITH_GRAFANA_KEY_PATH;

    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl http2;
    server_name REPLACE_WITH_ADMIN_DOMAIN;

    ssl_certificate REPLACE_WITH_ADMIN_CERT_PATH;
    ssl_certificate_key REPLACE_WITH_ADMIN_KEY_PATH;

    allow REPLACE_WITH_ADMIN_ALLOWED_CIDR;
    deny all;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
