      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "cloud-monitor-postgres"
          },
          "format": "table",
          "rawSql": "SELECT\n    md.region,\n    md.namespace,\n    count(DISTINCT md.resource_id) AS resources,\n    count(DISTINCT md.id) AS definitions,\n    count(mp.id) AS points\nFROM metric_definitions md\nLEFT JOIN metric_points mp\n    ON mp.metric_definition_id = md.id\n    AND $__timeFilter(mp.timestamp)\nGROUP BY md.region, md.namespace\nORDER BY md.region, md.namespace;",
          "refId": "A"
        }
      ],
      "title": "Metric Storage Summary",
      "type": "table"
    }
