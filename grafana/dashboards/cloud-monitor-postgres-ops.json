        {
          "datasource": {
            "type": "postgres",
            "uid": "cloud-monitor-postgres"
          },
          "format": "table",
          "rawSql": "SELECT\n    schemaname || '.' || relname AS table_name,\n    pg_total_relation_size(quote_ident(schemaname) || '.' || quote_ident(relname)) AS total_bytes\nFROM pg_stat_user_tables\nWHERE schemaname = 'public'\nORDER BY total_bytes DESC;",
          "refId": "A"
        }
      ],
      "title": "Table Size",
      "type": "table"
