{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudWatchMetricDiscoveryReadOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ResourceTagDiscoveryReadOnly",
      "Effect": "Allow",
      "Action": [
        "tag:GetResources",
        "tag:GetTagKeys",
        "tag:GetTagValues"
      ],
      "Resource": "*"
    }
  ]
}
